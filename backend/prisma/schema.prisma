generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — in production (Supabase) this is the pooled/PgBouncer
  // connection string (port 6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  // Used only by `prisma migrate` / `prisma db push` — must be a direct,
  // non-pooled connection (port 5432). Locally this is the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
  VERIFIER
  // Intellocarbon's own staff, entering data on behalf of assigned client
  // facilities — distinct from a client's own ADMIN/MEMBER users. Scoped
  // entirely by FacilityAssignment rather than Company ownership.
  DATA_ENTRY_INTERNAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String
  companyName      String?
  role             Role           @default(ADMIN)
  // Gates dashboard/API access — set on signup, flipped by a super admin from
  // the Pending Approvals panel. Existing pre-feature accounts were backfilled
  // to APPROVED (see migration), so this only blocks new signups.
  approvalStatus   ApprovalStatus @default(PENDING)
  // Independent of approvalStatus — a Super Admin can deactivate a
  // previously-approved verifier or internal operator (revokes login +
  // clears their current company/facility assignments) without touching
  // the approval history. Reactivating never restores old assignments;
  // those must be re-added deliberately.
  active           Boolean        @default(true)
  emailVerified    Boolean        @default(false)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  // Stamped on every authenticated request (requireAuth) and on token
  // issuance (login/signup/refresh) — the server-side source of truth for
  // the 15-minute idle timeout. Never trust a client-side JS timer alone for
  // this: browsers throttle/suspend timers in backgrounded or locked tabs.
  lastActivityAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  company                    Company?
  verificationsHandled       VerificationRequest[]       @relation("VerifierAssignments")
  brsrVerificationsHandled   BrsrVerificationRequest[]   @relation("BrsrVerifierAssignments")
  notifications              Notification[]
  auditLogs                  AuditLog[]
  queriesRaised              VerificationQuery[]         @relation("QueriesRaised")
  verifierCompanyAssignments VerifierCompanyAssignment[] @relation("VerifierCompanyAssignments")
  verifierAssignmentsMade    VerifierCompanyAssignment[] @relation("VerifierAssignmentsMadeBy")
  facilityAssignments        FacilityAssignment[]        @relation("InternalOperatorAssignments")
  facilityAssignmentsMade    FacilityAssignment[]        @relation("FacilityAssignmentsMadeBy")
  ghgEngagementsCreated      GhgEngagement[]
  crossCheckReviewsDone      CrossCheckReview[]
  manualPaymentsRecorded     ManualPayment[]             @relation("ManualPaymentsRecorded")
  manualPaymentsReversed     ManualPayment[]             @relation("ManualPaymentsReversed")
  customDealsSet             Subscription[]              @relation("CustomDealsSet")

  @@map("users")
}

// Whether the company's operating assets are owned, leased, or a mix — the
// only input that decides whether Scope 3 Categories 8 and 13 (upstream and
// downstream leased assets) exist for this company at all.
enum OwnershipModel {
  OWNED
  LEASED
  MIXED
}

// What the company actually does commercially, which is what makes Category 14
// (franchises) and 15 (investments) relevant — a manufacturer has neither.
enum BusinessModel {
  MANUFACTURER
  FRANCHISOR
  FINANCIAL_INSTITUTION
  DISTRIBUTOR
}

enum Sector {
  STEEL
  CEMENT
  ALUMINIUM
  FERTILIZER
  HYDROGEN
  ELECTRICITY
  OTHER
}

// Which border-carbon-adjustment regime a company is in scope for. The two
// are independent obligations with different scopes, calendars and pricing —
// a company exporting to both blocs holds both — so this is carried as a set
// on Company (see `cbamFrameworks`) rather than as a single-value field.
// UK CBAM's own applicability rules (sector list, £50,000 rolling-12-month
// registration threshold, included emission scopes) live in
// data/ukCbamReferenceData.ts; the EU's stay where they already are.
enum CbamFramework {
  EU_CBAM
  UK_CBAM
}

model Company {
  id                      String    @id @default(cuid())
  ownerId                 String    @unique
  owner                   User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                    String
  registrationNumber      String?
  gstin                   String?
  sector                  Sector
  subSector               String?
  address                 String?
  city                    String?
  state                   String?
  pincode                 String?
  country                 String    @default("India")
  annualTurnoverInr       Float?
  employeeCount           Int?
  reportingFyStartMonth   Int       @default(4)
  appliesCbam             Boolean   @default(false)
  appliesCcts             Boolean   @default(false)
  isPatDesignatedConsumer Boolean   @default(false)
  onboardingCompletedAt   DateTime?

  // Which CBAM regimes this company is in scope for. A set rather than a
  // single value or a second boolean: EU and UK CBAM are independent
  // obligations a company can hold either, both, or neither of, and a third
  // regime (several are drafting one) should not need another column.
  // `appliesCbam` above stays the master on/off switch for the CBAM module —
  // this only says *which* regimes apply once it is on, so nothing that
  // currently reads `appliesCbam` changes behaviour. Existing CBAM companies
  // are backfilled to [EU_CBAM] by the migration; the default is empty so a
  // new non-CBAM company isn't silently marked as an EU declarant.
  cbamFrameworks CbamFramework[] @default([])

  // One-time compliance onboarding fee. Company-level, not per-subscription:
  // it is charged once for the company, so holding a second tier must not
  // charge it again. `onboardingFeePaidAt` set means "settled, never charge
  // again" — including grandfathered companies that predate in-flow
  // collection, which are backfilled with an amount of 0 and were never
  // billed. `onboardingFeePaidInr` is what was actually collected.
  onboardingFeePaidInr Int?
  onboardingFeePaidAt  DateTime?

  // Scope 3 relevance drivers. Company-level rather than Facility-level: a
  // GHG Protocol Scope 3 inventory is drawn at the organisational boundary,
  // and the relevance endpoint keys off companyId. Categories 8/13 (leased
  // assets) turn on ownershipModel; 14 (franchises) and 15 (investments) turn
  // on businessModel. Defaults match the existing client base — owned plants
  // run by manufacturers — so pre-existing companies keep the same relevance
  // set they'd have had before these fields existed.
  ownershipModel OwnershipModel @default(OWNED)
  businessModel  BusinessModel  @default(MANUFACTURER)

  // EU declarant / importer of record — CBAM report page 4
  euImporterName         String?
  euImporterEori         String?
  euImporterCountry      String?
  euImporterContactEmail String?
  euImporterContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities           Facility[]
  // A company can hold more than one active tier at once (e.g. CBAM +
  // BRSR_CORE_REPORTING bought separately) — see [[companyId, tier]] below.
  // Was a 1:1 `Subscription?` until BRSR Core needed to be purchasable as a
  // standalone add-on alongside an existing CBAM/CCTS plan rather than only
  // as a pre-bundled combo tier like CBAM_PLUS_CCTS.
  subscriptions        Subscription[]
  verificationRequests VerificationRequest[]
  notifications        Notification[]
  brsrCoreReports      BrsrCoreReport[]
  issbS1S2Reports      IssbS1S2Report[]
  griReports           GriReport[]
  scope3Data           Scope3Data[]
  voluntaryOffsets     VoluntaryOffsetPurchase[]
  auditLogs            AuditLog[]
  reports              Report[]
  documents            Document[]
  verificationQueries  VerificationQuery[]
  verifierAssignments  VerifierCompanyAssignment[]
  manualPayments       ManualPayment[]

  @@map("companies")
}

enum SubscriptionTier {
  CCTS_COMPLIANCE
  CBAM_COMPLIANCE
  CBAM_PLUS_CCTS
  BRSR_CORE_REPORTING
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                     String             @id @default(cuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tier                   SubscriptionTier   @default(CCTS_COMPLIANCE)
  status                 SubscriptionStatus @default(INCOMPLETE)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?            @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  // Set when this subscription was auto-merged into a combined tier (e.g.
  // CCTS_COMPLIANCE -> CBAM_PLUS_CCTS after the company added the
  // complementary CBAM plan) — points at the new combined-tier row so
  // billing history can show "Upgraded to X" instead of a bare "Canceled"
  // with no explanation. Many old rows can point at the same combined row
  // (both the CCTS and, in a future 3-way combo, another constituent tier),
  // so this is a plain many-to-one FK, not unique.
  mergedIntoId String?
  mergedInto   Subscription?  @relation("SubscriptionMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Subscription[] @relation("SubscriptionMerge")

  payments Payment[]

  // Super Admin-negotiated custom deal terms — entirely independent of
  // Razorpay. When isCustomDeal is true, customFacilityCount (if set)
  // overrides the plan's standard facilityLimit in requireCapacityForNewFacility,
  // and customValidFrom/customValidUntil/customAmount are informational
  // terms shown on the admin company page (they don't drive status/
  // currentPeriodEnd — that's still set by whichever manual payment or
  // Razorpay charge activated the subscription).
  // Facilities this subscription currently covers under its per-facility
  // pricing (see PLANS[tier].priceInr — "₹X/facility/mo"). Defaults to 1,
  // matching the base plan; buying additional facility capacity for the
  // same tier (see billing.service.ts's addFacilityCapacity) increments
  // this in place rather than creating a second row, since a company can
  // only hold one Subscription per (companyId, tier). Superseded by
  // customFacilityCount when isCustomDeal is true, same as before.
  facilitiesIncluded Int @default(1)

  // Onboarding fee attached to this subscription's first invoice as a
  // Razorpay add-on at creation, in rupees. Null when none was attached
  // (dev-bypass, or the company had already paid). Recorded here rather than
  // inferred later because the company's facility count can change between
  // checkout and the webhook that confirms payment — and because a checkout
  // the customer abandons must never mark the fee as paid.
  onboardingFeeChargedInr Int?

  isCustomDeal        Boolean   @default(false)
  customFacilityCount Int?
  customValidFrom     DateTime?
  customValidUntil    DateTime?
  customAmount        Float?
  customSetByUserId   String?
  customSetBy         User?     @relation("CustomDealsSet", fields: [customSetByUserId], references: [id], onDelete: SetNull)
  customDealNotes     String?

  // One subscription row per (company, tier) — a company can hold several
  // tiers simultaneously (each its own Razorpay subscription), but can't
  // double-purchase the same tier twice.
  @@unique([companyId, tier])
  @@index([companyId])
  @@index([mergedIntoId])
  @@map("subscriptions")
}

model Payment {
  id                String       @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  razorpayPaymentId String?      @unique
  razorpayOrderId   String?
  amountInr         Float
  status            String
  paidAt            DateTime?
  createdAt         DateTime     @default(now())

  @@index([subscriptionId])
  @@map("payments")
}

enum ManualPaymentMode {
  CHEQUE
  NEFT
  RTGS
  UPI
  CASH
  OTHER
}

enum ManualPaymentStatus {
  RECORDED
  REVERSED
}

// Payment collected outside Razorpay (cheque/NEFT/UPI/cash), recorded by a
// Super Admin. Independent of Razorpay end to end — activation/reversal
// reuse billing.service.ts's activateSubscriptionForTier/markSubscriptionPastDue,
// the same functions the Razorpay webhook calls, so a company's subscription
// state doesn't care which path activated it.
model ManualPayment {
  id               String              @id @default(cuid())
  companyId        String
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Which (companyId, tier) Subscription row this payment activates —
  // Subscription is unique per (companyId, tier), not per company, since a
  // company can hold multiple tiers at once. Resolved via companyId+tier
  // (not a direct FK) at record/reversal time, same as devBypassCheckout.
  tier             SubscriptionTier
  amount           Float
  paymentMode      ManualPaymentMode
  referenceNumber  String?
  paymentDate      DateTime
  // Set explicitly by the Super Admin on the form — not auto-calculated —
  // since manual deals can be monthly, quarterly, or annual.
  validUntil       DateTime
  recordedByUserId String
  recordedBy       User                @relation("ManualPaymentsRecorded", fields: [recordedByUserId], references: [id])
  status           ManualPaymentStatus @default(RECORDED)
  reversedAt       DateTime?
  reversedByUserId String?
  reversedBy       User?               @relation("ManualPaymentsReversed", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  reversalReason   String?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("manual_payments")
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model VerificationRequest {
  id                  String             @id @default(cuid())
  activityDataId      String             @unique
  activityData        ActivityData       @relation(fields: [activityDataId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status              VerificationStatus @default(PENDING)
  verifierId          String?
  verifier            User?              @relation("VerifierAssignments", fields: [verifierId], references: [id])
  verifierOrg         String?
  accreditationNumber String?
  statement           String?
  // Free-text "qualifications or emphasis of matter" — deliberately separate
  // from `statement` (the verifier's main opinion) so the PDF can render them
  // as distinct labelled sections, matching Annex VI verification report style.
  qualifications      String?
  comments            String?
  // Annex VI checklist tick state — { [checklistItemId]: boolean }. The
  // canonical item list lives in data/annexVIChecklist.ts, not here, so
  // adding/editing items never needs a migration; decideRequest() checks
  // every canonical id is present and true before allowing APPROVED.
  checklistState      Json               @default("{}")
  submittedAt         DateTime           @default(now())
  decidedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  queries VerificationQuery[]

  @@index([companyId])
  @@index([verifierId])
  @@map("verification_requests")
}

enum VerificationQueryStatus {
  OPEN
  RESOLVED
}

// A verifier's question/concern raised against a specific verification
// request — the company admin sees and responds to it from their facility
// dashboard. Deciding a request (issuing the verification statement) is
// blocked while any query on it is still OPEN.
model VerificationQuery {
  id                    String                  @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest     @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  companyId             String
  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilityId            String
  facility              Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  raisedByVerifierId    String
  raisedByVerifier      User                    @relation("QueriesRaised", fields: [raisedByVerifierId], references: [id])
  queryText             String
  status                VerificationQueryStatus @default(OPEN)
  responseText          String?
  respondedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([verificationRequestId])
  @@index([companyId])
  @@index([facilityId])
  @@map("verification_queries")
}

// Which companies a verifier is allowed to see and work on — the verifier
// portal's dashboard/queue only ever shows requests for assigned companies,
// not the full platform. Managed from the Super Admin company detail page.
model VerifierCompanyAssignment {
  id             String   @id @default(cuid())
  verifierId     String
  verifier       User     @relation("VerifierCompanyAssignments", fields: [verifierId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedAt     DateTime @default(now())
  // Nullable — backfilled rows from before this column existed have no
  // recorded assigner. Same audit-trail shape as FacilityAssignment.assignedBy.
  assignedBy     String?
  assignedByUser User?    @relation("VerifierAssignmentsMadeBy", fields: [assignedBy], references: [id])

  @@unique([verifierId, companyId])
  @@index([companyId])
  @@map("verifier_company_assignments")
}

enum NotificationType {
  MONTHLY_REMINDER
  DEADLINE_WARNING_30D
  DEADLINE_URGENT_7D
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Set for facility-specific alerts (monthly reminder); null for
  // company-wide deadline alerts (which aren't about any one facility).
  facilityId  String?
  facility    Facility?        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  // Uniquely identifies "this alert, for this company, for this period" —
  // e.g. "monthly:<facilityId>:2026-07", "cbam-30d:2026-Q3", "ccts-7d:2026".
  // Lets the daily cron run unconditionally every day and rely on the
  // unique constraint below to silently no-op on days 2..N of a window,
  // instead of tracking "have I already sent this" separately. Encoding the
  // facility id inside the string (rather than making facilityId part of
  // the constraint) sidesteps Postgres treating NULL as distinct-from-NULL,
  // which would otherwise break dedup for the facility-less company-wide
  // alerts.
  dedupeKey   String
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([companyId, dedupeKey])
  @@index([userId])
  @@map("notifications")
}

enum AuditLogAction {
  REPORT_GENERATED
  MANUAL_PAYMENT_RECORDED
  MANUAL_PAYMENT_REVERSED
  CUSTOM_SUBSCRIPTION_SET
  CUSTOM_SUBSCRIPTION_REVERTED
}

// Minimal append-only event log for the per-facility "Recent Activity" feed
// (see facilityDashboard.service.ts) and the Super Admin overview's
// platform-wide activity feed. Only covers actions with no other timestamped
// record to source from — data submissions, verifier claims/decisions, and
// deadline alerts are read directly off ActivityData, VerificationRequest,
// and Notification instead of being duplicated here.
// facilityId is nullable to also cover company-level events (manual
// payments, custom subscription deals) that have no associated facility.
model AuditLog {
  id         String         @id @default(cuid())
  facilityId String?
  facility   Facility?      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Who triggered the action — nullable since not every future action type
  // will necessarily have one (e.g. a system/cron-triggered event).
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditLogAction
  detail     String
  createdAt  DateTime       @default(now())

  @@index([facilityId])
  @@map("audit_logs")
}

enum ReportType {
  CBAM
  CCTS
  BRSR
  // The UK CBAM return. A distinct type rather than a variant of CBAM: it is
  // a different regime with its own accounting period, deadline and
  // liability basis, and a facility can owe both in the same period — which
  // the (facility, reportType, period) uniqueness would otherwise collide on.
  UK_CBAM
  // GRI Standards 2021 sustainability report — see data/griStandards.ts.
  GRI
}

enum ReportStatus {
  GENERATED
}

// One row per (facility, reportType, period) — the record of a generated
// compliance report, from the dashboard's "Generate Report" flow. `pdfPath`
// is a stable human-readable reference (used for the download filename),
// not an on-disk path — the actual PDF bytes live on the linked Document
// row, since Render's filesystem is ephemeral and can't be used as durable
// storage.
model Report {
  id          String       @id @default(cuid())
  facilityId  String
  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportType  ReportType
  period      String
  generatedAt DateTime     @default(now())
  pdfPath     String
  status      ReportStatus @default(GENERATED)

  document Document?

  @@unique([facilityId, reportType, period])
  @@index([facilityId])
  @@map("reports")
}

enum DocumentType {
  REPORT
  // User-uploaded bills/invoices backing a specific activity_data submission
  // — see ActivityData.documents and the "Evidence Pending" flag it drives.
  SUPPORTING_EVIDENCE
}

// Either the generated PDF for a Report, or a user-uploaded supporting
// document for an ActivityData submission — exactly one of reportId /
// activityDataId is set, matching documentType. Both stored in Postgres
// (not on disk) since Render's filesystem is ephemeral; this is a separate
// table from Report so a future third document type can reuse it without a
// migration, and so list views never have to pull file bytes they don't need.
model Document {
  id              String        @id @default(cuid())
  facilityId      String
  facility        Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportId        String?       @unique
  report          Report?       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  activityDataId  String?
  activityData    ActivityData? @relation(fields: [activityDataId], references: [id], onDelete: Cascade)
  documentType    DocumentType  @default(REPORT)
  reportingPeriod String
  verified        Boolean       @default(false)
  fileName        String
  fileData        Bytes
  createdAt       DateTime      @default(now())

  crossCheckReview CrossCheckReview?

  @@index([facilityId])
  @@index([activityDataId])
  @@map("documents")
}

enum CrossCheckStatus {
  NOT_REVIEWED
  MATCHED
  MISMATCH
}

// Manual (no-OCR) side-by-side review of a submitted activity_data entry
// against one of its linked supporting documents — a reviewer explicitly
// confirms the numbers match or flags a mismatch, on top of the document
// merely existing (which only drives "Evidence Pending"). One row per
// document (documentId unique) rather than per (activityData, document)
// composite, since a document is only ever linked to a single activityData
// in this schema — activityDataId is kept alongside for direct filtering
// without an extra join. No row yet == NOT_REVIEWED, same "computed on read
// until acted on" convention as evidencePending; a row is only written once
// a reviewer actually confirms or flags.
model CrossCheckReview {
  id             String           @id @default(cuid())
  activityDataId String
  activityData   ActivityData     @relation(fields: [activityDataId], references: [id], onDelete: Cascade)
  documentId     String           @unique
  document       Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status         CrossCheckStatus @default(NOT_REVIEWED)
  notes          String?
  reviewedBy     String?
  reviewer       User?            @relation(fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([activityDataId])
  @@map("cross_check_reviews")
}

enum FacilityType {
  INTEGRATED_STEEL_PLANT
  EAF_MINI_MILL
  DRI_PLANT
  ROLLING_MILL
  PELLET_PLANT
  CEMENT_PLANT
  ALUMINIUM_SMELTER
  FERTILIZER_PLANT
  HYDROGEN_PLANT
  POWER_PLANT
  OTHER
}

enum HydrogenRoute {
  SMR
  SMR_CCS
  ELECTROLYSIS_GRID
  ELECTROLYSIS_RENEWABLE
  BIOMASS
}

model Facility {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  // Nullable to support autosaved drafts, which may not have these set yet —
  // both are required by app-layer validation before isDraft can flip false.
  facilityType         FacilityType?
  // Free-text production-route key (e.g. "BF_BOF", "CLINKER_PRODUCTION",
  // "HALL_HEROULT") validated app-side against a per-sector option list —
  // not a Prisma enum, since each new CBAM sector adds its own route set and
  // a shared enum would need a migration every time one changes.
  productionRoute      String?
  address              String?
  state                String?
  district             String?
  pincode              String?
  latitude             Float?
  longitude            Float?
  installedCapacityTpa Float?
  commissioningYear    Int?
  productsManufactured String[]
  cnCodes              String[]      @default([])
  // True until the user explicitly clicks "Mark as complete" — autosave
  // never sets this to false. Incomplete facilities are still visible (with
  // a Draft badge) but should be treated as not-yet-real by anything that
  // isn't the setup form itself.
  isDraft              Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  activityData        ActivityData[]
  notifications       Notification[]
  brsrCoreReports     BrsrCoreReport[]
  issbS1S2Reports     IssbS1S2Report[]
  griReports          GriReport[]
  scope3Data          Scope3Data[]
  voluntaryOffsets    VoluntaryOffsetPurchase[]
  auditLogs           AuditLog[]
  reports             Report[]
  documents           Document[]
  verificationQueries VerificationQuery[]
  assignments         FacilityAssignment[]

  @@index([companyId])
  @@map("facilities")
}

// Which internal (DATA_ENTRY_INTERNAL) operators may enter data for a given
// facility on Intellocarbon's behalf — the single access-control chokepoint
// for the internal data-entry portal, same role VerifierCompanyAssignment
// plays for the verifier portal. Managed from the Super Admin facility page.
model FacilityAssignment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("InternalOperatorAssignments", fields: [userId], references: [id], onDelete: Cascade)
  facilityId     String
  facility       Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  assignedAt     DateTime @default(now())
  assignedBy     String
  assignedByUser User     @relation("FacilityAssignmentsMadeBy", fields: [assignedBy], references: [id])

  @@unique([userId, facilityId])
  @@index([facilityId])
  @@map("facility_assignments")
}

enum DataEntryStatus {
  DRAFT
  SUBMITTED
}

model ActivityData {
  id                  String    @id @default(cuid())
  facilityId          String
  facility            Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  // Denormalised from the owning Company at creation time — lets the
  // calculation engine and reports branch per sector without an extra join.
  sector              Sector    @default(STEEL)
  // Nullable to support autosaved drafts — all four are required by
  // app-layer validation before status can flip to SUBMITTED.
  periodStart         DateTime?
  periodEnd           DateTime?
  productCategory     String?
  productionQuantityT Float?

  gridElectricityMwh         Float  @default(0)
  renewableElectricityMwh    Float  @default(0)
  gridEmissionFactorOverride Float?

  steamImportedGj             Float  @default(0)
  steamEmissionFactorOverride Float?

  // --- Cement (calcination) ---
  limestoneInputTonnes      Float?
  clinkerProducedTonnes     Float?
  clinkerConversionFraction Float?

  // --- Aluminium (PFC — perfluorocarbons from anode effects) ---
  cf4EmissionsTonnes  Float?
  c2f6EmissionsTonnes Float?
  anodeEffectMinutes  Float?

  // --- Fertilizer (N2O from nitric acid production + gas feedstock carbon) ---
  n2oProcessEmissionsTonnes Float?
  n2oAbatementFactorPct     Float?
  naturalGasFeedstockNm3    Float?

  // --- Hydrogen ---
  hydrogenRoute         HydrogenRoute?
  ccsCaptureRatePct     Float?
  hydrogenPurityPct     Float?
  byproductOxygenTonnes Float?

  // --- Electricity (CBAM SEE is per MWh exported to the EU, not per tonne) ---
  electricityGeneratedMwh  Float?
  electricityExportedEuMwh Float?
  ownUseElectricityMwh     Float?
  lineLossMwh              Float?

  // CBAM Article 9 deduction input — carbon price effectively paid in the
  // country of origin, expressed directly in EUR/tCO2e.
  carbonPricePaidEurPerTonne Float?
  // The same input for UK CBAM, in GBP/tCO2e. A separate field rather than a
  // converted view of the EUR one: there is no FX rate in this system, and
  // inventing one to cross-currency a regulatory deduction would breach the
  // platform's no-assumed-values rule. Null means no overseas carbon price
  // is being claimed against the UK liability.
  carbonPricePaidGbpPerTonne Float?
  // BEE-notified CCTS GHG emission intensity target for this sub-sector/cycle,
  // tCO2e per tonne product — left null until BEE actually notifies one.
  cctsTargetIntensity        Float?

  status DataEntryStatus @default(DRAFT)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fuelEntries            FuelEntry[]
  processMaterialEntries ProcessMaterialEntry[]
  precursorEntries       PrecursorEntry[]
  // Optional ISO 14046 water inventory for the same period. Deliberately a
  // child of ActivityData rather than its own facility-period table: water is
  // measured over the same period and divided by the same production quantity
  // as the GHG figures, so a separate table would duplicate periodStart /
  // periodEnd / productionQuantityT and let the two drift apart.
  waterEntries           WaterEntry[]
  calculationResult      EmissionCalculationResult?
  verificationRequest    VerificationRequest?
  // Supporting evidence (bills/invoices) backing this submission — an empty
  // list on a SUBMITTED entry is what "Evidence Pending" means; computed on
  // read, not stored, so it can never go stale.
  documents              Document[]
  crossCheckReviews      CrossCheckReview[]

  @@index([facilityId])
  @@map("activity_data")
}

model FuelEntry {
  id                        String       @id @default(cuid())
  activityDataId            String
  activityData              ActivityData @relation(fields: [activityDataId], references: [id], onDelete: Cascade)
  fuelType                  String
  quantity                  Float
  unit                      String
  emissionFactorOverrideCo2 Float?
  createdAt                 DateTime     @default(now())

  @@index([activityDataId])
  @@map("fuel_entries")
}

model ProcessMaterialEntry {
  id                     String       @id @default(cuid())
  activityDataId         String
  activityData           ActivityData @relation(fields: [activityDataId], references: [id], onDelete: Cascade)
  materialType           String
  quantityTonnes         Float
  emissionFactorOverride Float?
  createdAt              DateTime     @default(now())

  @@index([activityDataId])
  @@map("process_material_entries")
}

model PrecursorEntry {
  id                             String       @id @default(cuid())
  activityDataId                 String
  activityData                   ActivityData @relation(fields: [activityDataId], references: [id], onDelete: Cascade)
  materialType                   String
  quantityTonnes                 Float
  embeddedEmissionFactorOverride Float?
  sourceLabel                    String?
  createdAt                      DateTime     @default(now())

  @@index([activityDataId])
  @@map("precursor_entries")
}

// One measured water source for a reporting period — the ISO 14046 inventory
// line item, mirroring FuelEntry's shape (typed key validated against a code
// library, quantity, optional factor override).
//
// Volumes are m³. Withdrawal and discharge are both *measured* inputs;
// consumption is deliberately NOT a column — under ISO 14046 it is definitionally
// withdrawal minus discharge, and storing it too would let a facility submit a
// triple that doesn't balance. It is derived in waterCalculation.service.ts,
// which is also how BRSR Core's water disclosure already derives it.
model WaterEntry {
  id                       String       @id @default(cuid())
  activityDataId           String
  activityData             ActivityData @relation(fields: [activityDataId], references: [id], onDelete: Cascade)
  // Validated against WATER_SOURCE_LIBRARY (data/waterFactors.ts) at the
  // app layer, exactly as FuelEntry.fuelType is against FUEL_LIBRARY —
  // a String rather than an enum so adding a source is a code-only change.
  sourceType               String
  withdrawnM3              Float
  dischargedM3             Float        @default(0)
  // Per-line override of the source's freshwaterFactor, for the real case of
  // a municipal supply that is itself partly reclaimed water.
  freshwaterFactorOverride Float?
  createdAt                DateTime     @default(now())

  @@index([activityDataId])
  @@map("water_entries")
}

model EmissionCalculationResult {
  id             String       @id @default(cuid())
  activityDataId String       @unique
  activityData   ActivityData @relation(fields: [activityDataId], references: [id], onDelete: Cascade)

  // The CCTS-basis fields are named Ar2Bur3 after the GWP table they actually
  // apply (IPCC AR2, as gazetted under S.O. 2825(E) / BUR3 — never AR4). They
  // were originally misnamed Ar4, which is why every one of them carries an
  // @map back to its original physical column: the rename is a code-level
  // correction only, so no migration runs and no existing row is rewritten.
  // Rename the columns for real only alongside a data-preserving
  // ALTER TABLE ... RENAME COLUMN migration.
  directCombustionCo2eAr5     Float
  directCombustionCo2eAr2Bur3 Float @map("directCombustionCo2eAr4")
  directProcessCo2e           Float
  directPrecursorCo2e         Float

  // PFC (aluminium) and process N2O (fertilizer nitric acid) need dual-GWP
  // treatment like combustion CH4/N2O, so — unlike calcination/feedstock
  // carbon, which are CO2-only and fold into directProcessCo2e — they get
  // their own AR5/AR2-BUR3 columns.
  directPfcCo2eAr5            Float @default(0)
  directPfcCo2eAr2Bur3        Float @default(0) @map("directPfcCo2eAr4")
  directN2oProcessCo2eAr5     Float @default(0)
  directN2oProcessCo2eAr2Bur3 Float @default(0) @map("directN2oProcessCo2eAr4")

  indirectElectricityCo2e Float
  indirectSteamCo2e       Float

  totalDirectCo2eAr5        Float
  totalDirectCo2eAr2Bur3    Float @map("totalDirectCo2eAr4")
  totalEmissionsCbamAr5     Float
  totalEmissionsCctsAr2Bur3 Float @map("totalEmissionsCctsAr4")

  specificEmbeddedEmissionsCbam Float
  ghgIntensityCcts              Float

  // UK CBAM totals. Separate columns rather than a reuse of the EU ones
  // because the two regimes count different emissions: the UK's boundary at
  // its 1 Jan 2027 launch is Scope 1 + select precursors, with indirect
  // (electricity and imported steam) emissions deferred to 2029 — see
  // data/ukCbamReferenceData.ts. Computed for every entry, like the CCTS
  // columns beside them, so the number exists whether or not the company is
  // currently in UK scope; whether it *applies* is decided per report.
  totalEmissionsUkCbamAr5         Float @default(0)
  specificEmbeddedEmissionsUkCbam Float @default(0)

  gridEmissionFactorUsed Float
  breakdown              Json

  calculatedAt DateTime @default(now())

  @@map("emission_calculation_results")
}

// BRSR Core (SEBI HO/CFD/CFD-SEC-2/P/CIR/2023/122) — the 9 mandated ESG
// attributes for one facility's financial year. Attribute 1 (GHG footprint)
// is intentionally NOT stored here as a number — it is derived at report-build
// time from the existing ActivityData / EmissionCalculationResult rows for
// this facility that fall inside the FY (see `brsrCalculation.service.ts`),
// on the CCTS/AR2-BUR3 basis, so there is exactly one place that computes
// emissions. Every field below is a manual disclosure input the calculation
// engine has no other source for.
model BrsrCoreReport {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  // Financial year this disclosure covers, e.g. "FY2025-26" — resolved against
  // Company.reportingFyStartMonth to bound the ActivityData rollup window.
  reportingPeriod String

  // Denominator for every "per rupee of turnover" intensity ratio (attributes 1, 2, 3, 4).
  turnoverInr Float?

  // --- Attribute 2: Water footprint (manual entry) ---
  waterWithdrawnKl  Float?
  waterDischargedKl Float?

  // --- Attribute 3: Waste management (manual entry) ---
  wasteGeneratedTonnes Float?
  wasteRecoveredTonnes Float?

  // --- Attribute 4: Energy footprint — renewable/non-renewable SPLIT only;
  // the total itself is reused from existing fuel + electricity ActivityData. ---
  renewableEnergyConsumptionGj    Float?
  nonRenewableEnergyConsumptionGj Float?

  // --- Attribute 5: Employee wellbeing (manual entry) ---
  employeeCountTotal   Int?
  employeeCountFemale  Int?
  wagesPaidMaleInr     Float?
  wagesPaidFemaleInr   Float?
  safetyIncidentsCount Int?

  // --- Attribute 6: Gender diversity (manual entry) ---
  womenInWorkforcePct  Float?
  womenInManagementPct Float?

  // --- Attribute 7: Inclusive development (manual entry) ---
  procurementFromMsmePct Float?

  // --- Attribute 8: Openness of business — concentration risk (manual entry) ---
  purchasesFromTop10SuppliersPct Float?
  salesToTop10CustomersPct       Float?

  // --- Attribute 9: Customer fairness (manual entry) ---
  consumerComplaintsCount       Int?
  consumerComplaintsResolvedPct Float?

  // DRAFT -> SUBMITTED, same lifecycle as ActivityData. "Verified" is not a
  // status value here either, for the same reason it isn't on ActivityData —
  // it's derived from an APPROVED BrsrVerificationRequest, see below.
  status DataEntryStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verificationRequest BrsrVerificationRequest?

  // One BRSR Core disclosure per facility per financial year.
  @@unique([facilityId, reportingPeriod])
  @@index([companyId])
  @@map("brsr_core_reports")
}

// Mirrors VerificationRequest's shape for CBAM/CCTS — kept as its own model rather than
// a polymorphic one so the existing ActivityData verification flow is untouched.
model BrsrVerificationRequest {
  id                  String             @id @default(cuid())
  brsrCoreReportId    String             @unique
  brsrCoreReport      BrsrCoreReport     @relation(fields: [brsrCoreReportId], references: [id], onDelete: Cascade)
  status              VerificationStatus @default(PENDING)
  verifierId          String?
  verifier            User?              @relation("BrsrVerifierAssignments", fields: [verifierId], references: [id])
  verifierOrg         String?
  accreditationNumber String?
  statement           String?
  comments            String?
  submittedAt         DateTime           @default(now())
  decidedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([verifierId])
  @@map("brsr_verification_requests")
}

// ISSB IFRS S1 (General Requirements for Disclosure of Sustainability-related
// Financial Information) + IFRS S2 (Climate-related Disclosures), scaffolded
// at foundational level around the four pillars common to both standards:
// Governance, Strategy, Risk Management, Metrics & Targets. Scope 1/2 figures
// are NOT stored here — they are derived at report-build time from the same
// ActivityData / EmissionCalculationResult rows BRSR uses (see
// `issbCalculation.service.ts`), on the AR5/GHG-Protocol basis since IFRS S2
// follows international (not India BUR3) GWP convention. Scope 3 has no
// calculation engine support yet, so it is a manual disclosure input here.
model IssbS1S2Report {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  // Financial year this disclosure covers, e.g. "FY2025-26" — same convention
  // and Company.reportingFyStartMonth resolution as BrsrCoreReport.
  reportingPeriod String

  // --- Pillar 1: Governance ---
  governanceBodyOversight String?
  managementRole          String?

  // --- Pillar 2: Strategy ---
  climateRisksOpportunities  String?
  businessModelImpact        String?
  financialEffects           String?
  scenarioAnalysisResilience String?

  // --- Pillar 3: Risk Management ---
  riskIdentificationProcess String?
  riskManagementProcess     String?
  riskIntegrationOverall    String?

  // --- Pillar 4: Metrics & Targets ---
  // Scope 1 & 2 (tCO2e) are reused from the emissions calculation engine at
  // report-build time and NOT stored as columns here — see issbCalculation.service.ts.
  scope3Tco2e            Float?
  targetDescription      String?
  targetYear             Int?
  baselineYear           Int?
  baselineEmissionsTco2e Float?
  transitionPlan         String?
  internalCarbonPriceInr Float?
  climateCapexInr        Float?

  // DRAFT -> SUBMITTED, same lifecycle as BrsrCoreReport/ActivityData.
  status DataEntryStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One ISSB S1/S2 disclosure per facility per financial year.
  @@unique([facilityId, reportingPeriod])
  @@index([companyId])
  @@map("issb_s1_s2_reports")
}

// --- Scope 3 (GHG Protocol value-chain emissions) --------------------------
// A new, standalone calculation architecture, deliberately decoupled from the
// Scope 1/2 engine that powers CBAM/CCTS (ActivityData/EmissionCalculationResult)
// — see scope3Calculation.service.ts. Phase 1 covers the 5 GHG Protocol
// categories most relevant to Indian industrial clients; the other 10 are
// intentionally unmodelled for now (surfaced as "not yet supported" in the UI
// rather than silently omitted). Feeds the ESG Disclosure Bundle (BRSR Core +
// ISSB today) as an optional, additive supplement — not wired into either
// report's own calculation path, so submitting a BRSR/ISSB disclosure never
// depends on Scope 3 data existing.
// All 15 GHG Protocol categories are enumerated, but only the original five
// (1, 4, 6, 7, 11) have a calculation path in scope3Calculation.service.ts.
// The other ten exist so relevance can be reported per sector and so the UI
// can show a "Coming soon" card instead of silently omitting a category the
// company is actually obliged to disclose. Writing data against one of the ten
// is rejected at the service layer — see SUPPORTED_CATEGORIES.
enum Scope3Category {
  CAT1_PURCHASED_GOODS_SERVICES
  CAT2_CAPITAL_GOODS
  CAT3_FUEL_ENERGY_RELATED
  CAT4_UPSTREAM_TRANSPORT_DISTRIBUTION
  CAT5_WASTE_GENERATED_IN_OPERATIONS
  CAT6_BUSINESS_TRAVEL
  CAT7_EMPLOYEE_COMMUTING
  CAT8_UPSTREAM_LEASED_ASSETS
  CAT9_DOWNSTREAM_TRANSPORT_DISTRIBUTION
  CAT10_PROCESSING_OF_SOLD_PRODUCTS
  CAT11_USE_OF_SOLD_PRODUCTS
  CAT12_END_OF_LIFE_TREATMENT
  CAT13_DOWNSTREAM_LEASED_ASSETS
  CAT14_FRANCHISES
  CAT15_INVESTMENTS
}

enum Scope3Relevance {
  MANDATORY
  OPTIONAL
  NOT_APPLICABLE
}

// Per-sector materiality baseline for each of the 15 categories, following
// standard GHG Protocol materiality guidance. This table is the sector-level
// answer only; the company-specific overrides for Categories 8, 9, 13, 14 and
// 15 are applied on top from Company.ownershipModel / businessModel by
// scope3Relevance.service.ts, which is also what rewrites `reasoning` when an
// override fires. Seeded data, not user-editable — reseeding is idempotent on
// the [sector, category] unique key.
model Scope3CategoryRelevance {
  id     String @id @default(cuid())
  sector Sector

  // GHG Protocol category number, 1-15. Stored as an Int rather than the
  // Scope3Category enum so the table reads the way the standard is written
  // and so ordering by category needs no enum-to-number mapping in SQL.
  category Int

  relevance Scope3Relevance

  // Why this category carries this relevance for this sector, shown verbatim
  // in the UI tooltip and kept as the audit trail for the determination.
  reasoning String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sector, category])
  @@index([sector])
  @@map("scope3_category_relevance")
}

enum Scope3CalculationMethod {
  SPEND_BASED
  ACTIVITY_BASED
}

model Scope3Data {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  // Same "FY2025-26" convention as BrsrCoreReport/IssbS1S2Report, so a
  // facility's Scope 3 entries line up with the same reporting window.
  reportingPeriod String

  category          Scope3Category
  calculationMethod Scope3CalculationMethod

  // Shape depends on category + calculationMethod — see
  // scope3Calculation.service.ts for the per-combination input contract.
  // Kept as JSON rather than one column per possible field across 5
  // categories x 2 methods, matching EmissionCalculationResult's rationale
  // for ActivityData's per-sector inputs.
  inputData Json

  calculatedEmissionsTco2e Float
  // Exact cited factor set + version used for this calculation (e.g. "US EPA
  // Supply Chain GHG Emission Factors v1.3 (NAICS-6, 2022 data)" or "UK
  // DEFRA/DESNZ GHG Conversion Factors 2025 — Business travel- air") — always
  // populated, never a placeholder, matching the "cite exactly which factor
  // set and version" requirement this module was built against.
  emissionFactorSource     String

  // DRAFT -> SUBMITTED, same lifecycle as ActivityData/BrsrCoreReport/IssbS1S2Report.
  status DataEntryStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One entry per category per facility per reporting period — resaving the
  // same category upserts rather than accumulating duplicate rows.
  @@unique([facilityId, reportingPeriod, category])
  @@index([companyId])
  @@map("scope3_data")
}

// Carbon crediting programme a retired credit was issued by. An enum rather
// than free text so the offsets summary can group by registry without
// normalising "Verra" / "VCS" / "verra" by hand; OTHER is the escape hatch for
// programmes not listed, with the specifics going in notes.
enum OffsetRegistry {
  VERRA
  GOLD_STANDARD
  ACR
  CAR
  ART
  ICM
  OTHER
}

// The avoidance/removal x nature/engineered split buyers are increasingly
// asked to report against (SBTi, VCMI, ISO 14068 all draw the same
// distinction). Recorded exactly as the purchaser states it — see the model
// comment on why nothing here is checked.
enum OffsetCategory {
  AVOIDANCE_NATURE
  AVOIDANCE_ENGINEERED
  REMOVAL_NATURE
  REMOVAL_ENGINEERED
}

// A voluntary carbon credit purchase logged against a facility.
//
// TRACKING ONLY. Intellocarbon does not verify, rate, endorse or issue
// anything here: the registry, serial number, tonnage, category and vintage
// are all recorded exactly as the purchaser enters them. There is deliberately
// no uniqueness constraint on creditSerialNumber, no cross-check against a
// registry API, and no quality scoring — a duplicate or mistyped serial is the
// purchaser's record to correct, and silently rejecting one would imply an
// authority over the credit that this platform does not have. Format checks
// (tonnage > 0, vintage a plausible year) are the only validation.
//
// No unique key on (facility, period) either, unlike Scope3Data: a facility
// buys many credits, and each purchase is its own row.
model VoluntaryOffsetPurchase {
  id         String   @id @default(cuid())
  // Denormalised from the facility at write time, exactly as Scope3Data does,
  // so the company-wide ESG rollup can aggregate without joining through
  // facilities.
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  registry           OffsetRegistry
  // Free text: serial formats differ per registry and change over time, so
  // this is stored verbatim rather than parsed.
  creditSerialNumber String
  // tCO2e retired. Float to match every other tonnage on the platform
  // (calculatedEmissionsTco2e, totalEmissionsCbamAr5, ...).
  tonnageTco2e       Float
  category           OffsetCategory
  vintageYear        Int
  purchaseDate       DateTime

  // DRAFT -> SUBMITTED, same lifecycle as ActivityData / BrsrCoreReport /
  // Scope3Data. Only SUBMITTED purchases count towards the ESG summary.
  status DataEntryStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
  @@index([companyId])
  @@map("voluntary_offset_purchases")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

enum LeadTool {
  BORDER
  INDIA
  COMPLY
  // Voluntary carbon market project screening (/project-screener). Shares the
  // lead-capture contract with the three IntelloCalc tools above and nothing
  // else: those screen an entity's own compliance position, this screens a
  // project that would generate credits in a separate, voluntary market.
  PROJECT_SCREENER
  // "Notify me" waitlist signups for not-yet-built ESG frameworks on /esg —
  // lightweight (email only, see name/company below), tagged per framework so
  // demand signal is visible per-framework before committing to build order.
  ESG_GRI
  ESG_ISSB
  ESG_CSRD
  ESG_CDP
}

model LeadCapture {
  id          String   @id @default(cuid())
  // Nullable because ESG_* waitlist signups are email-only — the calculator
  // tools (BORDER/INDIA/COMPLY) still always supply both.
  name        String?
  email       String
  company     String?
  phone       String?
  toolUsed    LeadTool
  inputsJson  Json
  resultsJson Json
  followedUp  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([toolUsed])
  @@index([createdAt])
  @@map("lead_captures")
}

// Super-Admin-managed registry of emission/reference factors, with full
// history preserved rather than overwritten — every value change supersedes
// the current row (isCurrent -> false, validTo -> today) and creates a new
// one (isCurrent -> true, validFrom -> today) instead of mutating value in
// place. Two rows (name "CBAM Certificate Price" and "CEA Grid Emission
// Factor") are also the live source of truth the calculation engine reads
// at runtime — see getCbamCertificatePrice()/getGridEmissionFactor() in
// data/cbamReferenceData.ts / data/emissionFactors.ts, hydrated from this
// table at server startup and kept in sync on every quick-update write.
// Every other row is a documentation/audit record only — the fuel/material/
// precursor calculation library remains code-defined, not DB-driven.
model EmissionFactor {
  id                  String    @id @default(cuid())
  name                String
  // Free-text, not a Prisma enum — the two "quick update" values (CBAM
  // certificate price, CEA grid factor) aren't fuels at all, and the fuel
  // library itself already has its own key space (see FUEL_LIBRARY).
  fuelType            String?
  greenhouseGas       String?
  value               Float
  unit                String
  // Hard platform rule: no assumed values — every factor must cite the
  // regulation/annex it comes from. Enforced non-empty at the validator
  // layer on every create/update/supersede, not just at the DB level.
  source              String
  validFrom           DateTime
  validTo             DateTime?
  sectorApplicability String?
  isCurrent           Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isCurrent])
  @@index([fuelType])
  @@map("emission_factors")
}

// Which GWP table (and reporting-standard label) a GHG Runner engagement
// uses — see data/ghgJurisdictions.ts, the single source of truth for the
// actual GWP values. This enum only names the jurisdiction; adding one
// doesn't require touching the calculation engine beyond that config file.
enum GhgJurisdiction {
  US_CALIFORNIA
  UK
  AUSTRALIA
  UAE_MIDDLE_EAST
  EU
  OTHER_GHG_PROTOCOL
}

enum GhgEngagementStatus {
  DRAFT
  FINALIZED
}

// One manual GHG Protocol engagement for Intellocarbon's foreign consulting
// work — organization-based (not facility-based like the Indian CBAM/CCTS
// product), entered entirely by a Super Admin with no client login. Scope 1/2/3
// entries are stored as Json rather than child tables: they're small,
// engagement-scoped lists with no cross-engagement querying need, and Scope 3
// in particular is deliberately schema-ready-but-UI-disabled — see
// ghgCalculation.service.ts for the Scope1Entry/Scope2Entry/Scope3Entry shapes
// these columns hold.
model GhgEngagement {
  id                   String          @id @default(cuid())
  organizationName     String
  country              String
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  jurisdiction         GhgJurisdiction
  // Informational only — not used in any calculation.
  numberOfSites        Int?

  scope1Entries Json @default("[]")
  scope2Entries Json @default("[]")
  // Coming soon — collected in the schema now (scope3Category 1-15,
  // description, quantity, factor, source) so turning it on later is a UI
  // change, not a migration. Never included in totalTco2e.
  scope3Entries Json @default("[]")

  // Frozen at every create/update from the entries + jurisdiction GWP table
  // as they stood at save time — once FINALIZED, the engagement can no
  // longer be edited (see requireDraftEngagement), so these numbers never
  // drift even if the Emission Factor Manager's library values change later.
  scope1TotalTco2e Float?
  scope2TotalTco2e Float?
  totalTco2e       Float?
  // Snapshot of which GWP scheme (AR5/AR6) was applied — see
  // data/ghgJurisdictions.ts — so the PDF can always state exactly what was
  // used even if a jurisdiction's config is later corrected.
  gwpSchemeUsed    String?

  status GhgEngagementStatus @default(DRAFT)

  // White-label PDF, generated only once FINALIZED — bytes in Postgres,
  // same storage approach as the Document table, but engagements have no
  // Company/Facility to hang a Document row off, so this lives directly on
  // the engagement instead of extending that shared multi-tenant table.
  reportPdfFileName String?
  reportPdfData     Bytes?
  reportGeneratedAt DateTime?

  createdBy     String
  createdByUser User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationName])
  @@index([status])
  @@map("ghg_engagements")
}

enum CctsEntityStatus {
  DRAFT
  FINAL
}

// Reference registry for the public "CCTS Obligated Entities Tracker" —
// which named companies/plants BEE has notified as obligated under India's
// Carbon Credit Trading Scheme, sector by sector, via gazette notification.
// Manually curated only (see Regulatory Watch admin panel): these are legal
// documents, so entries are added/edited by a human verifying against the
// actual gazette text, never auto-scraped from secondary sources.
model CctsObligatedEntity {
  id          String  @id @default(cuid())
  companyName String
  // Free-text, not the CBAM `Sector` enum above — CCTS's own notified
  // sector list (Aluminium, Cement, Chlor-Alkali, Fertilizer, Iron & Steel,
  // Petrochemicals, Petroleum Refining, Pulp & Paper, Textile) is a distinct
  // regulatory list from CBAM's product-based sectors and doesn't map 1:1.
  sector      String
  // e.g. "Integrated", "EAF", "DRI" for Iron & Steel — free-text since each
  // sector's sub-classification differs and BEE's own lists aren't uniform.
  subSector   String?
  state       String
  district    String?

  // Which gazette notification this entry comes from, e.g. "G.S.R. 234(E)".
  notificationReference String
  notificationDate      DateTime
  // DRAFT = named in a draft notification still open for public comment
  // (e.g. Iron & Steel's 26 June 2026 revised draft, 60-day comment window)
  // — not yet a final obligation. FINAL = gazetted and binding.
  status                CctsEntityStatus @default(DRAFT)

  // Only populated where BEE has actually published these in the
  // notification — most draft-stage entries won't have them yet.
  baselineIntensity Float?
  targetIntensity   Float?

  sourceUrl        String?
  // When a Super Admin last checked this row against the source gazette —
  // distinct from updatedAt, which also ticks on typo fixes that aren't a
  // fresh verification pass.
  lastVerifiedDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector])
  @@index([state])
  @@index([status])
  @@map("ccts_obligated_entities")
}

// ===========================================================================
// GRI Standards 2021
//
// Full implementation: GRI 2 (General Disclosures), GRI 3 (Material Topics,
// including the materiality assessment that determines which Topic Standards
// are reported at all), and 16 Topic Standards.
//
// The controlling design decision is that GRI 3 comes FIRST. Unlike BRSR Core
// (a fixed list of 9 attributes) or ISSB (a fixed 4 pillars), GRI does not
// have a fixed set of topics: the materiality assessment output decides which
// Topic Standards are in scope, and a topic that is not material is legitimately
// omitted provided the omission is stated. GriMaterialTopic is therefore not a
// convenience index — it is the gate. griContentIndex.service.ts reads it to
// decide what appears in the mandatory content index, and gri.service.ts reads
// it to decide what must be filled in before submit.
//
// Version notes (which edition of each standard, and why) live in
// src/data/griStandards.ts, which is the registry every consumer reads.
// In short: there is no GRI 307 model (withdrawn — folded into Disclosure
// 2-27 on GriUniversalDisclosures) and biodiversity is GRI 101: Biodiversity
// 2024, not the superseded GRI 304.
//
// As with BRSR and ISSB, emissions/energy/water figures are NOT stored on
// these tables where the platform can already derive them — see
// griCalculation.service.ts. Stored columns are manual disclosures the
// calculation engines have no source for.
// ===========================================================================

model GriReport {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  // "FY2025-26" — resolved against Company.reportingFyStartMonth, same as BRSR/ISSB.
  reportingPeriod String

  // Shared denominator for the GRI 302-3 energy-intensity and GRI 305-4
  // emissions-intensity ratios where the organization elects a revenue basis.
  turnoverInr Float?

  status DataEntryStatus @default(DRAFT)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialityAssessment GriMaterialityAssessment?
  universalDisclosures  GriUniversalDisclosures?
  materialTopics        GriMaterialTopic[]

  materialsDisclosure         GriMaterialsDisclosure?
  energyDisclosure            GriEnergyDisclosure?
  waterDisclosure             GriWaterDisclosure?
  biodiversityDisclosure      GriBiodiversityDisclosure?
  emissionsDisclosure         GriEmissionsDisclosure?
  wasteDisclosure             GriWasteDisclosure?
  supplierEnvDisclosure       GriSupplierEnvDisclosure?
  employmentDisclosure        GriEmploymentDisclosure?
  ohsDisclosure               GriOhsDisclosure?
  trainingDisclosure          GriTrainingDisclosure?
  diversityDisclosure         GriDiversityDisclosure?
  nonDiscriminationDisclosure GriNonDiscriminationDisclosure?
  localCommunitiesDisclosure  GriLocalCommunitiesDisclosure?
  supplierSocialDisclosure    GriSupplierSocialDisclosure?
  customerHsDisclosure        GriCustomerHsDisclosure?
  customerPrivacyDisclosure   GriCustomerPrivacyDisclosure?

  // One GRI report per facility per financial year, matching BRSR/ISSB.
  @@unique([facilityId, reportingPeriod])
  @@index([companyId])
  @@map("gri_reports")
}

// GRI 3-1: Process to determine material topics. Re-run each reporting period
// (GRI expects material topics to evolve), which is why this hangs off
// GriReport rather than off Facility.
model GriMaterialityAssessment {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // Identified stakeholder groups, free-text so a facility isn't forced into
  // a fixed taxonomy GRI itself doesn't impose.
  stakeholderGroups             String[] @default([])
  stakeholderEngagementApproach String?
  impactIdentificationProcess   String?
  prioritisationProcess         String?

  // Significance score at or above which a topic is treated as material.
  // Stored rather than constant: GRI requires the threshold to be disclosed,
  // and a facility may justify a different one year to year.
  materialityThreshold Float @default(3)

  // Set when the user finishes the assessment. Topic gating only takes effect
  // once this is non-null — a half-finished assessment must not silently
  // exclude topics from the report.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impacts GriImpact[]

  @@map("gri_materiality_assessments")
}

// Whether an impact has already occurred or could occur, and its direction.
// GRI 3 scores the two directions differently — see GriImpact below.
enum GriImpactType {
  NEGATIVE_ACTUAL
  NEGATIVE_POTENTIAL
  POSITIVE_ACTUAL
  POSITIVE_POTENTIAL
}

// Where in the value chain the impact sits. GRI 3 requires impacts to be
// identified across activities and business relationships, not just own
// operations.
enum GriValueChainLocation {
  OWN_OPERATIONS
  UPSTREAM
  DOWNSTREAM
}

// One actual or potential impact identified during the materiality assessment.
//
// Scoring follows GRI 3's actual methodology rather than the generic
// "impact x likelihood" matrix. For NEGATIVE impacts, significance is the
// SEVERITY of the impact, determined by scale, scope and irremediability. For
// POSITIVE impacts, severity does not apply and significance is scale and
// scope only. For POTENTIAL impacts of either direction, likelihood is also
// factored in. irremediability is therefore meaningful only on negative
// impacts, and likelihood only on potential ones — both are nullable for that
// reason, and the score is computed in griCalculation.service.ts, never stored
// as user input.
model GriImpact {
  id           String                   @id @default(cuid())
  assessmentId String
  assessment   GriMaterialityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Which Topic Standard this impact rolls up into — validated against
  // GRI_TOPIC_CODES at the app layer, a String rather than an enum so adding
  // a Topic Standard is a code-only change (same rationale as
  // Facility.productionRoute).
  topicCode   String
  description String

  impactType         GriImpactType
  valueChainLocation GriValueChainLocation @default(OWN_OPERATIONS)

  // All 1-5. scale = how grave/beneficial, scope = how widespread,
  // irremediability = how hard to counteract (negative only),
  // likelihood = probability of occurring (potential only).
  scale           Int
  scope           Int
  irremediability Int?
  likelihood      Int?

  // Derived from the above by computeImpactSignificance(). Persisted so the
  // ranking shown in the UI, the matrix chart in the PDF, and the gating
  // decision can never disagree with each other.
  significanceScore Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@map("gri_impacts")
}

// GRI 3-2 (the list of material topics) and GRI 3-3 (management of each one).
//
// One row per Topic Standard the facility considered — INCLUDING topics judged
// not material, because GRI requires the report to be explicit about what was
// assessed and excluded rather than silently dropping it. isMaterial is what
// gates the disclosure form and the PDF section.
model GriMaterialTopic {
  id          String    @id @default(cuid())
  griReportId String
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  topicCode  String
  isMaterial Boolean @default(false)

  // Highest significance score among this topic's impacts, and its 1-based
  // position once material topics are sorted by that score. Both derived.
  significanceScore Float?
  rank              Int?

  // Required by app-layer validation when isMaterial is false — an unexplained
  // exclusion is exactly what the content index must not contain.
  notMaterialRationale String?

  // --- GRI 3-3: Management of material topics (six sub-requirements a-f) ---
  impactsDescription     String?
  involvementDescription String?
  policiesCommitments    String?
  actionsTaken           String?
  effectivenessTracking  String?
  stakeholderEngagement  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One judgement per topic per report.
  @@unique([griReportId, topicCode])
  @@index([griReportId])
  @@map("gri_material_topics")
}

// GRI 2: General Disclosures 2021 — all 30 disclosures (2-1 to 2-30).
// Always reported in full; never materiality-gated. Field names map 1:1 to
// GRI_UNIVERSAL_DISCLOSURES in data/griStandards.ts, which is what the content
// index walks.
model GriUniversalDisclosures {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // --- 2-1 Organizational details (prefilled from Company/Facility) ---
  legalName            String?
  ownershipLegalForm   String?
  headquartersLocation String?
  countriesOfOperation String?

  // --- 2-2 Entities included ---
  entitiesIncluded String?

  // --- 2-3 Reporting period, frequency, contact point ---
  reportingFrequency String?
  contactPoint       String?
  publicationDate    DateTime?

  // --- 2-4 Restatements ---
  restatements String?

  // --- 2-5 External assurance ---
  externalAssurancePolicy String?
  assuranceProvider       String?
  assuranceLevel          String?

  // --- 2-6 Activities, value chain, business relationships ---
  sectorsServed                  String?
  valueChainDescription          String?
  significantChangesToValueChain String?

  // --- 2-7 Employees (head count at end of reporting period) ---
  employeesTotal          Int?
  employeesFemale         Int?
  employeesMale           Int?
  employeesPermanent      Int?
  employeesTemporary      Int?
  employeesFullTime       Int?
  employeesPartTime       Int?
  employeeDataMethodology String?

  // --- 2-8 Workers who are not employees ---
  nonEmployeeWorkersTotal       Int?
  nonEmployeeWorkersDescription String?

  // --- 2-9 to 2-18 Governance ---
  governanceStructure             String?
  governanceCommittees            String?
  governanceNominationProcess     String?
  chairIsSeniorExecutive          Boolean?
  chairRoleDescription            String?
  governanceImpactOversight       String?
  impactResponsibilityDelegation  String?
  governanceReportingRole         String?
  conflictsOfInterestProcess      String?
  criticalConcernsProcess         String?
  criticalConcernsCount           Int?
  governanceCollectiveKnowledge   String?
  governancePerformanceEvaluation String?

  // --- 2-19 to 2-21 Remuneration ---
  remunerationPolicies         String?
  remunerationProcess          String?
  // 2-21: ratio of the highest-paid individual's total annual compensation to
  // the median for all other employees. A ratio, not a currency amount.
  compensationRatio            Float?
  compensationRatioIncreasePct Float?

  // --- 2-22 to 2-26 Strategy, policies, practices ---
  sustainableDevelopmentStatement String?
  policyCommitments               String?
  humanRightsPolicyCommitment     String?
  policyEmbedding                 String?
  remediationProcesses            String?
  adviceAndConcernsMechanisms     String?

  // --- 2-27 Compliance with laws and regulations ---
  // Replaces the withdrawn GRI 307 (environmental) and GRI 419
  // (socioeconomic) topic standards — see data/griStandards.ts. Covers both,
  // which is why it is not scoped to environmental fines alone.
  significantFinesCount          Int?
  significantFinesValueInr       Float?
  nonMonetarySanctionsCount      Int?
  complianceIncidentsDescription String?

  // --- 2-28 to 2-30 ---
  membershipAssociations          String?
  stakeholderEngagementApproach   String?
  collectiveBargainingCoveragePct Float?
  collectiveBargainingDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_universal_disclosures")
}

// --- GRI 301: Materials 2016 ---
model GriMaterialsDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 301-1
  renewableMaterialsTonnes    Float?
  nonRenewableMaterialsTonnes Float?
  materialsMethodology        String?
  // 301-2
  recycledInputPct            Float?
  // 301-3
  reclaimedProductsPct        Float?
  reclaimedByCategory         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_materials_disclosures")
}

// --- GRI 302: Energy 2016 ---
// NOTE: superseded by GRI 103: Energy 2025 for reporting periods beginning on
// or after 1 Jan 2027. See data/griStandards.ts before extending this model.
model GriEnergyDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 302-1. Electricity and steam are derived from ActivityData where present
  // (see griCalculation.service.ts); these columns capture what the platform
  // cannot compute — notably fuel energy in GJ, since FUEL_LIBRARY carries
  // emission factors but no calorific values.
  nonRenewableFuelGj              Float?
  renewableFuelGj                 Float?
  electricityConsumedGj           Float?
  heatingConsumedGj               Float?
  coolingConsumedGj               Float?
  steamConsumedGj                 Float?
  electricitySoldGj               Float?
  energyStandardsUsed             String?
  // 302-2
  energyOutsideOrgGj              Float?
  // 302-3
  intensityDenominatorDescription String?
  intensityIncludesOutsideOrg     Boolean?
  // 302-4
  energyReductionGj               Float?
  energyReductionBaseYear         Int?
  energyReductionBasis            String?
  // 302-5
  productEnergyReductionGj        Float?
  productEnergyReductionBasis     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_energy_disclosures")
}

// --- GRI 303: Water and Effluents 2018 ---
// Volumes are MEGALITRES, per GRI 303's stated unit. The platform's own water
// inventory (WaterEntry) is in m3; conversion happens in
// griCalculation.service.ts (1 ML = 1000 m3), not here, so there is one place
// the unit boundary is crossed.
model GriWaterDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 303-1
  interactionsNarrative       String?
  waterStressAssessmentTool   String?
  // 303-2
  dischargeImpactManagement   String?
  minimumEffluentStandards    String?
  // 303-3 — totals are derived from WaterEntry when available; the
  // water-stressed split never is, since no water-stress dataset is wired in.
  withdrawalTotalMl           Float?
  withdrawalWaterStressedMl   Float?
  withdrawalFreshwaterMl      Float?
  // 303-4
  dischargeTotalMl            Float?
  dischargeWaterStressedMl    Float?
  dischargeFreshwaterMl       Float?
  prioritySubstancesOfConcern String?
  // 303-5
  consumptionTotalMl          Float?
  consumptionWaterStressedMl  Float?
  storageChangeMl             Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_water_disclosures")
}

// --- GRI 101: Biodiversity 2024 ---
// Replaces GRI 304: Biodiversity 2016, mandatory for reporting published on or
// after 1 Jan 2026. Structured around GRI 101's five direct drivers of
// biodiversity loss rather than GRI 304's protected-areas-only framing.
model GriBiodiversityDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 101-1
  policiesNarrative            String?
  // 101-2
  mitigationHierarchy          String?
  landRestoredHa               Float?
  // 101-3
  accessBenefitSharing         String?
  // 101-4
  impactIdentificationProcess  String?
  // 101-5
  sitesTotalCount              Int?
  sitesInProtectedAreasCount   Int?
  sitesNearProtectedAreasCount Int?
  siteLocationsDescription     String?
  // 101-6 — the five direct drivers
  driverLandUseChange          String?
  driverResourceExploitation   String?
  driverClimateChange          String?
  driverPollution              String?
  driverInvasiveSpecies        String?
  landUseChangeHa              Float?
  // 101-7
  stateOfBiodiversityChanges   String?
  // 101-8
  ecosystemServicesAffected    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_biodiversity_disclosures")
}

// --- GRI 305: Emissions 2016 ---
// Scope 1 and Scope 2 (location-based) are NOT stored — they are derived from
// EmissionCalculationResult on the AR5/GHG-Protocol basis, which is the basis
// GRI 305 follows (the same reasoning as ISSB, and deliberately not the
// AR2/BUR3 basis BRSR Core uses). Scope 3 is rolled up from Scope3Data.
// NOTE: superseded by GRI 102: Climate Change 2025 for reporting periods
// beginning on or after 1 Jan 2027.
model GriEmissionsDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 305-1 context
  biogenicCo2Tonnes                 Float?
  baseYear                          Int?
  baseYearEmissionsTco2e            Float?
  gasesIncluded                     String?
  consolidationApproach             String?
  emissionsStandardsUsed            String?
  // 305-2 — market-based has no engine source (requires supplier contractual
  // instruments the platform does not hold), so it is a manual disclosure
  // alongside the derived location-based figure.
  scope2MarketBasedTco2e            Float?
  // 305-3
  scope3CategoriesIncluded          String?
  // 305-4
  intensityDenominatorDescription   String?
  intensityGasesIncluded            String?
  // 305-5
  reductionTco2e                    Float?
  reductionBaseYear                 Int?
  reductionScopesIncluded           String?
  // 305-6
  odsCfc11EquivalentTonnes          Float?
  odsSubstancesIncluded             String?
  // 305-7
  noxTonnes                         Float?
  soxTonnes                         Float?
  vocTonnes                         Float?
  particulateMatterTonnes           Float?
  persistentOrganicPollutantsTonnes Float?
  hazardousAirPollutantsTonnes      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_emissions_disclosures")
}

// --- GRI 306: Waste 2020 ---
// The 306-4/306-5 grid is hazardous x non-hazardous crossed with recovery and
// disposal operations. Totals (306-3 waste generated, and the diverted/directed
// subtotals) are deliberately NOT columns — they are sums of these, and storing
// them too would let a facility submit a set that doesn't add up. Same
// rationale as WaterEntry omitting consumption.
model GriWasteDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 306-1 / 306-2
  wasteImpactsNarrative       String?
  wasteManagementNarrative    String?
  thirdPartyWasteManagement   String?
  // 306-3
  wasteCompositionDescription String?

  // 306-4 Diverted from disposal
  hazardousDivertedReuseT            Float?
  hazardousDivertedRecyclingT        Float?
  hazardousDivertedOtherRecoveryT    Float?
  nonHazardousDivertedReuseT         Float?
  nonHazardousDivertedRecyclingT     Float?
  nonHazardousDivertedOtherRecoveryT Float?

  // 306-5 Directed to disposal
  hazardousDisposalIncinerationWithRecoveryT    Float?
  hazardousDisposalIncinerationNoRecoveryT      Float?
  hazardousDisposalLandfillT                    Float?
  hazardousDisposalOtherT                       Float?
  nonHazardousDisposalIncinerationWithRecoveryT Float?
  nonHazardousDisposalIncinerationNoRecoveryT   Float?
  nonHazardousDisposalLandfillT                 Float?
  nonHazardousDisposalOtherT                    Float?

  // GRI 306 requires onsite/offsite to be distinguished; captured as narrative
  // rather than doubling the 14-column grid to 28.
  onsiteOffsiteBreakdown String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_waste_disclosures")
}

// --- GRI 308: Supplier Environmental Assessment 2016 ---
model GriSupplierEnvDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 308-1
  newSuppliersScreenedPct              Float?
  newSuppliersTotalCount               Int?
  screeningCriteria                    String?
  // 308-2
  suppliersAssessedCount               Int?
  suppliersWithNegativeImpactsCount    Int?
  suppliersWithImprovementsAgreedCount Int?
  suppliersTerminatedCount             Int?
  negativeImpactsDescription           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_supplier_env_disclosures")
}

// --- GRI 401: Employment 2016 ---
model GriEmploymentDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 401-1 — GRI requires breakdown by age group, gender and region. Region is
  // narrative since this is a single-facility disclosure.
  newHiresTotal                  Int?
  newHiresFemale                 Int?
  newHiresUnder30                Int?
  newHires30To50                 Int?
  newHiresOver50                 Int?
  turnoverTotal                  Int?
  turnoverFemale                 Int?
  turnoverUnder30                Int?
  turnover30To50                 Int?
  turnoverOver50                 Int?
  hiresTurnoverRegionalBreakdown String?
  // 401-2
  benefitsDescription            String?
  // 401-3
  parentalLeaveEntitledMale      Int?
  parentalLeaveEntitledFemale    Int?
  parentalLeaveTookMale          Int?
  parentalLeaveTookFemale        Int?
  parentalLeaveReturnedMale      Int?
  parentalLeaveReturnedFemale    Int?
  parentalLeaveRetainedMale      Int?
  parentalLeaveRetainedFemale    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_employment_disclosures")
}

// --- GRI 403: Occupational Health and Safety 2018 ---
model GriOhsDisclosure {
  id          String    @id @default(cuid())
  griReportId String    @unique
  griReport   GriReport @relation(fields: [griReportId], references: [id], onDelete: Cascade)

  // 403-1 to 403-7 — narrative disclosures
  managementSystemDescription         String?
  managementSystemIsIso45001          Boolean?
  hazardIdentificationProcess         String?
  occupationalHealthServices          String?
  workerParticipation                 String?
  workerOhsTraining                   String?
  workerHealthPromotion               String?
  businessRelationshipOhsImpacts      String?
  // 403-8
  workersCoveredCount                 Int?
  workersCoveredPct                   Float?
  // 403-9 — rates are derived, not stored. rateBasisHours is 200000 or
  // 1000000; GRI 403 permits either but requires the choice to be stated.
  hoursWorked                         Float?
  fatalitiesEmployees                 Int?
  fatalitiesNonEmployees              Int?
  highConsequenceInjuriesEmployees    Int?
  highConsequenceInjuriesNonEmployees Int?
  recordableInjuriesEmployees         Int?
  recordableInjuriesNonEmployees      Int?
  mainInjuryTypes                     String?
  rateBasisHours                      Int?
  // 403-10
  illHealthFatalitiesEmployees        Int?
  illHealthCasesEmployees             Int?
  illHealthFatalitiesNonEmployees     Int?
  illHealthCasesNonEmployees          Int?
  illHealthHazards                    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gri_ohs_disclosures")
}

